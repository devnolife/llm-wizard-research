# Backend-specific environment overrides (optional)
# Precedence: root ../.env is loaded first as the main configuration;
# backend/.env is loaded second with override=True for backend-only overrides.
# Keep real secrets out of this example; copy keys to ../.env or .env as needed.

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=1

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2000
LLM_CONTEXT_WINDOW=8192
LLM_TIMEOUT=120
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=4

# Vector Database
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=research_papers_ml
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# External API Keys (optional; leave empty in examples)
SEMANTIC_SCHOLAR_API_KEY=
PUBMED_API_KEY=
PUBMED_EMAIL=
CROSSREF_EMAIL=
CORE_API_KEY=
UNPAYWALL_EMAIL=
# Elsevier key (gratis, dev.elsevier.com) — dipakai sumber "scopus" (jalan dari mana saja)
# dan "sciencedirect" (butuh IP kampus pelanggan atau ELSEVIER_INSTTOKEN)
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
IEEE_API_KEY=
SPRINGER_API_KEY=

# Data Paths
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed

# Retrieval Configuration
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.15
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RERANK_ENABLED=true
CHUNK_STRATEGY=sections

# OCR Configuration (ocrd service at ~/ocr-service, port 8792)
OCR_ENABLED=true
OCR_SERVICE_URL=http://127.0.0.1:8792
OCR_API_KEY=
OCR_IMAGE_MODE=gundam
OCR_DPI=0
OCR_TIMEOUT=1800
OCR_PREFER_TEXT_LAYER=true
OCR_VALIDATE_ON_STARTUP=false

# Durable local analysis queue and metadata-only telemetry
ANALYSIS_QUEUE_WORKERS=2
ANALYSIS_JOB_MAX_ATTEMPTS=2
ANALYSIS_JOB_RETENTION_DAYS=30
TELEMETRY_ENABLED=true
TELEMETRY_RETENTION_DAYS=14

# Neo4j (Optional - for knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# copilotd — service Go Copilot SDK (github.com/devnolife/copilot-sdk-go).
# Bila diisi, idea-to-query memakai GitHub Copilot (enterprise) dan
# fallback otomatis ke Ollama lokal bila mati.
COPILOTD_URL=
COPILOTD_API_KEY=
COPILOTD_MODEL=claude-opus-4.8-fast

# ── Upgraded gap pipeline (TAHAP 1-3) ──────────────────────────────
# GROBID server for high-quality PDF metadata + IMRaD sections (optional).
# Empty = fall back to pymupdf + regex-DOI + CrossRef/OpenAlex. Run GROBID with:
#   docker compose --profile grobid up -d grobid   ->   GROBID_URL=http://localhost:8070
GROBID_URL=
# On-disk cache dir for external paper-API responses (CrossRef/OpenAlex/S2).
PIPELINE_API_CACHE_DIR=
